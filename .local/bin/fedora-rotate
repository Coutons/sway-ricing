#!/usr/bin/env bash
# Rotasi wallpaper otomatis — Fedora Sway Rice (sway/waybar-safe)
set -euo pipefail

STATE_DIR="$HOME/.cache/fedora-sway"
STATE_FILE="$STATE_DIR/rotate"
CURRENT_FILE="$STATE_DIR/current"
mkdir -p "$STATE_DIR"

# Folder wallpaper: override lewat FEDORA_WALLPAPER_DIR (kompatibel RYOKU_WALLPAPER_DIR lama).
WALL_DIR=""
if [ -n "${FEDORA_WALLPAPER_DIR:-${RYOKU_WALLPAPER_DIR:-}}" ]; then
  WALL_DIR="${FEDORA_WALLPAPER_DIR:-$RYOKU_WALLPAPER_DIR}"
else
  U="${USER:-$(id -un)}"
  for d in \
    "/mnt/Dataku/wallpaper" \
    "/media/$U/Dataku/wallpaper" \
    "/run/media/$U/Dataku/wallpaper" \
    "$HOME/Pictures/wallpapers" \
    "$HOME/.config/fedora-sway/wallpapers" \
    "$HOME/.config/fedora-sway/wallpaper.png"; do
    if [ -d "$d" ]; then WALL_DIR="$d"; break; fi
  done
fi

# Kumpulkan semua wallpaper (urut deterministik agar tidak lompat aneh)
AVAILABLE=()
if [ -d "$WALL_DIR" ]; then
  while IFS= read -r -d '' f; do
    b=$(basename "$f")
    case "$b" in "udemy coupons"*|.*) continue;; esac
    AVAILABLE+=("$f")
  done < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.jxl' \) -print0 | sort -z)
fi

# Fallback: wallpaper.png Fedora Sway + background bawaan Fedora
if [ ${#AVAILABLE[@]} -eq 0 ]; then
  for w in \
    "$HOME/.config/fedora-sway/wallpaper.png" \
    "/usr/share/backgrounds/default.jxl" \
    "/usr/share/backgrounds/default-dark.jxl" \
    "/usr/share/backgrounds/f45/default" \
    "/usr/share/backgrounds/images/default-16_9.jxl"; do
    if [ -f "$w" ]; then AVAILABLE+=("$w"); fi
  done
fi
[ ${#AVAILABLE[@]} -gt 0 ] || { echo "no wallpapers available"; exit 1; }

INTERVAL="${FEDORA_WALL_INTERVAL:-600}"   # 10 menit
MODE="${1:---daemon}"

is_on() {
  [ -f "$STATE_FILE" ] || { echo on > "$STATE_FILE"; echo on; return; }
  cat "$STATE_FILE"
}

pick_wall() {
  # Urut + random anti-acak: pilih yang berbeda dari current
  local cur=""
  [ -f "$CURRENT_FILE" ] && cur=$(cat "$CURRENT_FILE")
  local w=""
  for _ in $(seq 1 8); do
    w="${AVAILABLE[$RANDOM % ${#AVAILABLE[@]}]}"
    [ "$w" != "$cur" ] && break
  done
  echo "$w"
}

set_wall() {
  local w="$1"
  echo "$w" > "$CURRENT_FILE"
  pkill -x swaybg 2>/dev/null || true
  nohup setsid swaybg -i "$w" -m fill >/dev/null 2>&1 </dev/null &
}

case "$MODE" in
  --daemon)
    exec 200>>"$STATE_DIR/fedora-rotate.lock"
    flock -n 200 || exit 0
    while true; do
      if [ "$(is_on)" = "on" ]; then set_wall "$(pick_wall)"; fi
      sleep "$INTERVAL" 200>&-
    done
    ;;
  --once)
    set_wall "$(pick_wall)"
    ;;
  --toggle)
    if [ "$(is_on)" = "on" ]; then echo off > "$STATE_FILE"; echo "wallpaper-auto: OFF"; else echo on > "$STATE_FILE"; echo "wallpaper-auto: ON"; fi
    ;;
  --status) echo "wallpaper-auto: $(is_on)" ;;
  *) echo "usage: fedora-rotate [--daemon|--once|--toggle|--status]"; exit 2 ;;
esac
