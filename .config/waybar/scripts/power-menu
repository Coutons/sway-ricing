#!/bin/bash

options="  Lock\n󰍃  Logout\n󰤄  Suspend\n  Reboot\n  Power Off"

chosen=$(echo -e "$options" | wofi --dmenu -i -p "Power Menu")

case "$chosen" in
  *Power\ Off) systemctl poweroff ;;
  *Reboot) systemctl reboot ;;
  *Suspend) systemctl suspend ;;
  *Logout) swaymsg exit || pkill -KILL -u $USER ;;
  *Lock) swaylock ;;
esac

